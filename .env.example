# Copy to .env for local development. Do not commit .env.

# Postgres connection string used by the api (/db-ping) and the worker.
# Matches the docker-compose.yml service below.
DATABASE_URL=postgresql://health:health@localhost:5432/health

# Browser origins allowed to call the api (comma-separated). The local Next.js dev
# server runs on :3000.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Log verbosity for the api (DEBUG/INFO/WARNING/ERROR).
LOG_LEVEL=INFO

# The web app proxies /api/* to this origin (apps/web/next.config.ts), and the home
# Server Component fetches it directly. Browser auth calls go to same-origin /api.
API_ORIGIN=http://localhost:8000

# --- Auth (M1) ---
# Signs session JWTs. Generate a strong random value for any deployed environment, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me
# API_BASE_URL builds the magic-link URL. Point it at the web proxy (/api) so the login
# link is same-origin to the web app and the session cookie is set first-party.
API_BASE_URL=http://localhost:3000/api
WEB_BASE_URL=http://localhost:3000
# Comma-separated emails allowed to bootstrap a login (no public sign-up).
AUTH_ALLOWED_EMAILS=you@example.com
# Cookie flags: locally http+lax; in production (cross-site https) use true + none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Email (M1, Resend) ---
# Leave RESEND_API_KEY unset locally to use the console sender (prints the login link
# to the api logs). Set both in production.
# RESEND_API_KEY=
EMAIL_FROM=Health Agent <onboarding@resend.dev>

# --- Encryption (M1) ---
# Fernet key for encrypting stored OAuth tokens. Generate your own:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=AoiLqfVpiKqQOSx-rO57uKQwAdoAuxZK-FAGmFj1OSg=

# --- Whoop (M1) ---
# From your Whoop developer app. The redirect URI must be registered there verbatim.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8000/v1/whoop/callback
WHOOP_API_BASE=https://api.prod.whoop.com

# --- Coach / LLM (M1) ---
# Without ANTHROPIC_API_KEY the coach uses a deterministic stub (chat + briefings).
# Used by both the api (chat) and the worker (briefings).
# ANTHROPIC_API_KEY=
COACH_MODEL=claude-haiku-4-5
